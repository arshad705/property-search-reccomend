# Root-level .env — used by Docker Compose for variable substitution.
# Copy to .env and fill in values before running `docker compose up`.
#
#   cp .env.example .env

# Postgres password shared between the postgres container and the backend service.
# Must match the password in backend/.env DATABASE_URL.
POSTGRES_PASSWORD=hdb_advisor

# Backend URL baked into the frontend's static bundle at build time (Vite
# convention — the browser calls this directly, it does not go through the
# Docker network). Leave as-is unless you remap the backend's published port.
VITE_API_BASE_URL=http://localhost:8001
