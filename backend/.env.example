# Database
DATABASE_URL=postgresql+psycopg2://hdb_advisor:hdb_advisor@localhost:5433/hdb_advisor

# 99.co API (RapidAPI, provider: Happy Endpoint, slug: 99-co-sg-api)
RAPIDAPI_KEY=
RAPIDAPI_HOST=99-co-sg-api.p.rapidapi.com

# data.gov.sg
DATA_GOV_SG_RESOURCE_ID=d_8b84c4ee58e3cfc0ece0d773c8ca6abc

# Google Maps Platform — Places API (New) + Geocoding API, replaced OneMap
# entirely (OneMap had no MRT station or school data, only hawker centres).
# Requires a Google Cloud project with billing enabled, even for free-tier
# usage — see the project spec's Public APIs section for setup steps.
GOOGLE_MAPS_API_KEY=

# When true, services fall back to backend/fixtures/*.json instead of calling
# live APIs. Useful for offline demos or when API keys aren't configured yet.
USE_FIXTURES=true

# watsonx Orchestrate — powers the /chat/message endpoint that the chat UI calls.
# WXO_API_KEY is the same key you type in for `orchestrate env activate hdb-advisor`.
# Auth is IBM Cloud IAM (inferred from the "cloud.ibm.com" instance URL, same as the
# ADK CLI) — leave WXO_IAM_URL blank to use IAM's default token endpoint.
WXO_INSTANCE_URL=WXO_INSTANCE_URL=https://api.au-syd.watson-orchestrate.cloud.ibm.com/instances/YOUR_INSTANCE_ID
WXO_API_KEY=
WXO_IAM_URL=
WXO_AGENT_NAME=supervisor_agent
